# PHARMACI - Reverse proxy Caddy
#
# Sécurisé : HTTPS automatique (via le domaine), headers de sécurité,
# et AUCUN proxy dynamique (le bloc XTransformPort a été supprimé : il
# ouvrait une faille SSRF permettant d'atteindre n'importe quel port interne).
#
# Définir la variable d'environnement PHARMACI_DOMAIN avec votre domaine,
# ex:  export PHARMACI_DOMAIN=pharmaci.example.ci
# (en dev/local, on peut garder :80 pour du HTTP simple sur localhost.)

{
	# Defaults globaux
	email {$PHARMACI_CONTACT_EMAIL:admin@pharmaci.ci}
}

{$PHARMACI_DOMAIN::80} {
	# --- Headers de sécurité ---
	header {
		# Empêche le MIME-sniffing
		X-Content-Type-Options "nosniff"
		# Empêche le clickjacking
		X-Frame-Options "DENY"
		# Référeur minimal
		Referrer-Policy "strict-origin-when-cross-origin"
		# Permissions navigateur réduites
		Permissions-Policy "geolocation=(self), microphone=(self), camera=(self)"
		# CSP : on charge seulement depuis nous-mêmes. Images/audio depuis
		# blob:/data: (TTS/STT) etLeaflet. Aucune source 'unsafe-inline'
		# JS ; les styles inline de Next sont couverts par 'unsafe-inline'
		# pour les styles uniquement.
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https:; media-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src 'self' https: ws: wss:; font-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		# HSTS (uniquement pertinent en HTTPS ; ignoré en HTTP)
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Supprime les headers serveur bavards
		-Server
	}

	# --- Reverse proxy vers l'app Next.js (port 3000) ---
	reverse_proxy localhost:3000 {
		header_up Host {host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}
	}

	# --- WebSocket de messagerie (port 3003) ---
	# Le client se connecte sur le même domaine pour bénéficier des cookies
	# d'authentification (http-only) et du même origin (anti-CSWSH).
	@ws {
		header Connection *Upgrade*
		header Upgrade websocket
	}
	handle @ws {
		reverse_proxy localhost:3003
	}
}
