# Base de données (SQLite)
DATABASE_URL="file:./dev.db"

# Secret JWT — générez une valeur aléatoire forte (>= 32 caractères) en production
JWT_SECRET="change-me-to-a-long-random-value"

# Envoi d'e-mails (mot de passe oublié) via l'API Resend (https://resend.com)
# Sans ces variables, le code de réinitialisation est seulement journalisé
# côté serveur (mode dégradé, utile en développement local).
RESEND_API_KEY=""
EMAIL_FROM="PHARMACI <onboarding@resend.dev>"
